{
  "name": "solid-use",
  "version": "0.10.0",
  "description": "A collection of SolidJS utilities",
  "keywords": [
    "hooks",
    "primitives",
    "solid-js",
    "use"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-use/tree/main/packages/solid-use",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-use/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/solid-use.git",
    "directory": "packages/solid-use"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "atom": [
        "./dist/atom.d.ts"
      ],
      "client-only": [
        "./dist/client-only.d.ts"
      ],
      "fetch": [
        "./dist/fetch.d.ts"
      ],
      "media-query": [
        "./dist/media-query.d.ts"
      ],
      "online-status": [
        "./dist/online-status.d.ts"
      ],
      "page-visibility": [
        "./dist/page-visibility.d.ts"
      ],
      "props": [
        "./dist/props.d.ts"
      ],
      "provider": [
        "./dist/provider.d.ts"
      ],
      "server-value": [
        "./dist/server-value.d.ts"
      ],
      "string": [
        "./dist/string.d.ts"
      ]
    }
  },
  "exports": {
    "./atom": {
      "import": "./dist/atom.js",
      "require": "./dist/atom.cjs"
    },
    "./client-only": {
      "import": "./dist/client-only.js",
      "require": "./dist/client-only.cjs"
    },
    "./fetch": {
      "import": "./dist/fetch.js",
      "require": "./dist/fetch.cjs"
    },
    "./media-query": {
      "import": "./dist/media-query.js",
      "require": "./dist/media-query.cjs"
    },
    "./online-status": {
      "import": "./dist/online-status.js",
      "require": "./dist/online-status.cjs"
    },
    "./page-visibility": {
      "import": "./dist/page-visibility.js",
      "require": "./dist/page-visibility.cjs"
    },
    "./props": {
      "import": "./dist/props.js",
      "require": "./dist/props.cjs"
    },
    "./provider": {
      "import": "./dist/provider.js",
      "require": "./dist/provider.cjs"
    },
    "./server-value": {
      "import": "./dist/server-value.js",
      "require": "./dist/server-value.cjs"
    },
    "./string": {
      "import": "./dist/string.js",
      "require": "./dist/string.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "publint": "^0.3.24",
    "solid-js": "^1.9.15",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "solid-js": "^1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
