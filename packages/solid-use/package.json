{
  "name": "solid-use",
  "version": "1.0.0-next.3",
  "private": false,
  "description": "A collection of SolidJS utilities",
  "keywords": [
    "hooks",
    "primitives",
    "solid-js",
    "use"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-use/tree/main/packages/solid-use",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-use/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "https://github.com/lxsmnsyc/solid-use.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./atom": "./dist/atom.js",
    "./client-only": "./dist/client-only.js",
    "./fetch": "./dist/fetch.js",
    "./media-query": "./dist/media-query.js",
    "./online-status": "./dist/online-status.js",
    "./page-visibility": "./dist/page-visibility.js",
    "./props": "./dist/props.js",
    "./provider": "./dist/provider.js",
    "./server-value": "./dist/server-value.js",
    "./string": "./dist/string.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "tsdown",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@solidjs/web": "2.0.0-rc.5",
    "@types/node": "^22.13.10",
    "jsdom": "^27.4.0",
    "pridepack": "2.6.4",
    "solid-js": "2.0.0-rc.5",
    "tsdown": "^0.21.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "solid-js": "^2.0.0-rc.5"
  },
  "engines": {
    "node": ">=20"
  }
}
