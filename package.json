{
  "name": "root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "cs:add": "changeset add",
    "cs:pub": "changeset publish",
    "cs:ver": "changeset version && pnpm install --lockfile-only",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "release": "node scripts/publish.ts",
    "type-check": "tsc --noEmit && pnpm -r run type-check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lxsmnsyc/oxlint-config": "^0.1.3",
    "@types/node": "^26.6.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.4"
}
